# GEMINI_API_KEY: Kun til serversiden (ALDRIG med VITE_-præfiks!).
# I Google AI Studio injiceres den automatisk som runtime secret.
# I ekstern produktion konfigureres den som ren server-secret i hostingmiljøet.
GEMINI_API_KEY=

# VITE_GOOGLE_MAPS_API_KEY: Offentlig domænebegrænset Google Maps browser-nøgle (valgfri)
VITE_GOOGLE_MAPS_API_KEY=""

# APP_URL: Applikationens offentlige URL
APP_URL=""

# VITE_USE_BACKEND_PROXY: Sæt til "true" i ekstern produktion, så Gemini-kald routes sikkert via /api/gemini.
VITE_USE_BACKEND_PROXY="false"

